# All browser requests use /api on the current origin, even during local
# development. Vite proxies this path to Express; Netlify rewrites it to
# Render. Do not set a separate VITE_API_URL or expose backend secrets here.

# Optional: enables live delivery tracking updates (Supabase Realtime) on the
# order tracking page. Use the SAME project as your backend, but the PUBLIC
# anon key only - never the service role key. Without these, tracking still
# works, it just needs a manual page refresh to see status changes.
VITE_SUPABASE_URL=replace_with_your_value
VITE_SUPABASE_ANON_KEY=replace_with_your_value
